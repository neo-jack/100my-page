# 公开地址；VITE_* 会进入浏览器，不能填写模型密钥。
VITE_SITE_ORIGIN=http://www.lanbinquan.top
VITE_AI_ENDPOINT=/api/ai/chat
# 本地代理目标；独立后端可改为 http://127.0.0.1:3001。
AI_PROXY_TARGET=http://www.lanbinquan.top
# 留空关闭监控；正式站点设置脚本地址和上报地址。
VITE_MONITOR_SCRIPT=
VITE_MONITOR_ENDPOINT=
VITE_MONITOR_HOST=
VITE_MONITOR_PROJECT=3Dpage
